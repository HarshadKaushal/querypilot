{
  "name": "@ayd/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run generate --workspace=@ayd/database && node scripts/dev.cjs",
    "build": "npm run generate --workspace=@ayd/database && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "npm run test:unit",
    "test:unit": "npm run build --workspace=@ayd/ssrf-guard && npm run build --workspace=@ayd/crypto && npm run build --workspace=@ayd/sql-guard && npm run build --workspace=@ayd/database && npm run build --workspace=@ayd/core && node ../../scripts/jest.cjs --config jest.unit.config.cjs",
    "test:int": "npm run generate --workspace=@ayd/database && node ../../scripts/jest.cjs --config jest.int.config.cjs --runInBand",
    "test:e2e": "npm run generate --workspace=@ayd/database && node ../../scripts/jest.cjs --config jest.e2e.config.cjs --runInBand",
    "try-query": "node scripts/try-query.cjs"
  },
  "dependencies": {
    "@ayd/core": "*",
    "@ayd/crypto": "*",
    "@ayd/database": "*",
    "@ayd/shared": "*",
    "@ayd/sql-guard": "*",
    "@ayd/ssrf-guard": "*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "~12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  }
}
