// Generated into src/ and compiled with the package, as CommonJS like the rest of the repo.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id
  googleSubject String         @unique @map("google_subject")
  email         String
  name          String
  avatarUrl     String?        @map("avatar_url")
  planTier      String         @default("free") @map("plan_tier")
  createdAt     DateTime       @default(now()) @map("created_at")
  lastLoginAt   DateTime       @map("last_login_at")
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  connections   Connection[]
  queries       QueryRecord[]
  usage         UsageCounter[]

  @@map("users")
}

model Connection {
  id                  String            @id
  userId              String            @map("user_id")
  label               String
  host                String
  port                Int
  databaseName        String            @map("database_name")
  sslMode             String            @map("ssl_mode")
  usernameCiphertext  String            @map("username_ciphertext")
  usernameIv          String            @map("username_iv")
  usernameTag         String            @map("username_tag")
  passwordCiphertext  String            @map("password_ciphertext")
  passwordIv          String            @map("password_iv")
  passwordTag         String            @map("password_tag")
  encryptedDataKey    String            @map("encrypted_data_key")
  dataKeyIv           String            @map("data_key_iv")
  dataKeyTag          String            @map("data_key_tag")
  keyVersion          Int               @map("key_version")
  status              String
  lastTestedAt        DateTime?         @map("last_tested_at")
  sendSampleRowsToLlm Boolean           @default(false) @map("send_sample_rows_to_llm")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemaSnapshots     SchemaSnapshot[]
  allowedObjects      AllowedObject[]
  cachedProposals     QueryCacheEntry[]
  queries             QueryRecord[]

  @@index([userId])
  @@map("connections")
}

model RefreshToken {
  id           String    @id
  userId       String    @map("user_id")
  familyId     String    @map("family_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  deviceInfo   String?   @map("device_info")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id
  userId    String?  @map("user_id")
  eventType String   @map("event_type")
  metadata  Json
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_log")
}

model SchemaSnapshot {
  id           String     @id
  connectionId String     @map("connection_id")
  version      Int
  document     Json
  tableCount   Int        @map("table_count")
  columnCount  Int        @map("column_count")
  createdAt    DateTime   @default(now()) @map("created_at")
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, version])
  @@map("schema_snapshots")
}

model AllowedObject {
  id           String     @id
  connectionId String     @map("connection_id")
  schemaName   String     @map("schema_name")
  tableName    String     @map("table_name")
  columnName   String?    @map("column_name")
  description  String?
  createdAt    DateTime   @default(now()) @map("created_at")
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("allowed_objects")
}

// Validated SQL proposals, so a repeated question skips the model (blueprint 7). The key is
// the connection, the allowlisted schema's fingerprint (it changes with every refresh and
// allowlist edit), and a hash of the normalized question. Never holds result rows.
model QueryCacheEntry {
  id           String     @id
  connectionId String     @map("connection_id")
  fingerprint  String
  questionHash String     @map("question_hash")
  sql          String
  assumptions  Json
  explanation  String
  model        String
  hits         Int        @default(0)
  createdAt    DateTime   @default(now()) @map("created_at")
  lastUsedAt   DateTime   @default(now()) @map("last_used_at")
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, fingerprint, questionHash])
  @@map("query_cache")
}

// One finished question or SQL job, for the owner's history (blueprint 7 and 8.4). Holds
// what was asked, the SQL that ran, the outcome, and the cost. Never result rows; the
// summary is kept because history shows it, and it only names values the summary model
// was allowed to see.
model QueryRecord {
  id            String     @id
  userId        String     @map("user_id")
  connectionId  String     @map("connection_id")
  kind          String
  question      String?
  sql           String?
  status        String
  errorCode     String?    @map("error_code")
  rowCount      Int?       @map("row_count")
  truncated     String?
  schemaVersion Int?       @map("schema_version")
  cached        Boolean    @default(false)
  summary       String?
  models        Json
  inputTokens   Int        @default(0) @map("input_tokens")
  outputTokens  Int        @default(0) @map("output_tokens")
  llmMs         Int        @default(0) @map("llm_ms")
  queryMs       Int        @default(0) @map("query_ms")
  totalMs       Int        @default(0) @map("total_ms")
  createdAt     DateTime   @map("created_at")
  finishedAt    DateTime   @default(now()) @map("finished_at")
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection    Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("queries")
}

// Per user, per UTC day (blueprint 7): questions finished, rows returned, and model tokens,
// for the usage endpoint. Kept apart from history, so deleting history does not erase usage.
model UsageCounter {
  userId       String   @map("user_id")
  day          DateTime @db.Date
  questions    Int      @default(0)
  rowsReturned Int      @default(0) @map("rows_returned")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("usage_counters")
}
