# Local process configuration.
# Copy to .env at the repository root. Never commit .env.
# These values are for Docker Desktop on the host. Compose overrides hostnames
# for the api and worker containers.

NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info

# Application database (accounts and metadata only). Not the user's database.
DATABASE_URL=postgresql://ayd:ayd@localhost:5434/ayd

# Queue, cache, and shared limits.
REDIS_URL=redis://localhost:6379

# Signs access tokens. Use a different long random value outside this laptop.
AUTH_JWT_SECRET=local-development-jwt-secret-32b-min
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=1209600

# Local-only sign-in. Refused when NODE_ENV=production.
DEV_LOGIN_ENABLED=true
APP_WEB_ORIGIN=http://localhost:5173

# Optional. Leave blank until you have a Google OAuth client.
# The redirect URI must match the value registered in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/google/callback

# Wraps connection passwords. The value is version:base64(32 bytes).
# This local key is the base64 of the 32 ASCII bytes 0123456789abcdef repeated.
# SSRF_ALLOW_PRIVATE is refused when NODE_ENV=production.
CRYPTO_MASTER_KEY_VERSION=1
CRYPTO_MASTER_KEYS=1:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
SSRF_ALLOW_PRIVATE=true
EGRESS_IP=192.0.2.10

# Most rows one answer may return. The SQL guard adds or lowers LIMIT to this.
SQL_ROW_CAP=1000

# Sample user database, seeded by infra/sample-db/init.sql.
# Use the read-only role when a later phase connects as a user would.
# Host port 5433 maps to Postgres inside the sample-db container.
SAMPLE_DATABASE_URL=postgresql://sample_ro:sample_ro_password@localhost:5433/sample
